# Server
NODE_ENV=development
PORT=5000
# Every origin the customer/rider app is served from, comma separated. Testing
# on a phone means the app is reached at a LAN address as well as at localhost,
# and both CORS and the socket handshake have to allow each one:
#   FRONTEND_URL=http://localhost:3000,http://192.168.1.8:3000
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/hayabusa

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Maps
# auto  = use Google when a key is set below, otherwise the free OSM stack
# google = force Google (Places, Geocoding and Directions must be enabled)
# osm    = force Nominatim + OSRM, no key and no billing required
MAPS_PROVIDER=auto
GOOGLE_MAPS_API_KEY=

# Only used by the osm provider. The public Nominatim instance is rate limited
# to roughly one request per second and asks for an identifying User-Agent;
# point these at your own instances for production traffic.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
MAPS_USER_AGENT=Hayabusa/1.0 (ride booking backend)

# Pricing
FARE_PER_KM=8
FARE_CURRENCY=INR

# Matching
RIDE_REQUEST_TIMEOUT_SECONDS=20
MATCHING_RADIUS_KM=5
MAX_RIDERS_PER_REQUEST=10

# OTP
OTP_MAX_ATTEMPTS=5
# 64 hex characters, used to encrypt the copy of the pickup code the customer can
# read back. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Left empty, a key is derived from JWT_ACCESS_SECRET — fine for development,
# but set it explicitly in production so rotating the JWT secret keeps codes readable.
OTP_ENCRYPTION_KEY=

# Rider location writes are throttled to avoid hammering Mongo at high frequency
LOCATION_MIN_UPDATE_INTERVAL_MS=3000

# ---------------------------------------------------------------- admin panel
# The admin console signs its own tokens, so an admin session and a customer
# session can never be swapped even if one leaks. Left empty, a key is derived
# from JWT_ACCESS_SECRET — fine for development; set it explicitly in
# production so rotating the customer secret does not sign every operator out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# How long an operator stays signed in. There is no refresh token: an ops
# console left open on an unattended machine is the thing being avoided.
ADMIN_SESSION_EXPIRES_IN=8h

# The origin the console is served from. It is allowed through CORS and the
# socket handshake; anything else is refused.
ADMIN_URL=http://localhost:5174

# Read once, by `npm run admin:create`, to create the first super admin. Fill
# these in, run the script, then clear them — after that, admins are created
# from inside the console.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Super Admin

# ------------------------------------------------------------- AI assistant
# The key for the Raahi Assistant, from https://aistudio.google.com/apikey
#
# This is a SERVER secret. It is read by this process only: the browser talks to
# /api/v1/assistant and never to Google, so the key is never shipped in the
# frontend bundle. Never copy it into the client as VITE_GEMINI_API_KEY, and
# never put a real key in this example file.
#
# Left empty, the assistant reports itself unavailable and everything else in
# the platform carries on as normal.
GEMINI_API_KEY=your_gemini_api_key

# Which model answers. PIN A VERSION — do not use a `-latest` alias.
#
# Google retires the model behind an alias without repointing the alias, so
# `gemini-flash-latest` started answering 404 on every request when the model it
# pointed at was withdrawn. That surfaces as "the assistant is temporarily
# unavailable", which is true of nothing a restart will fix.
#
# To see what this key can actually call:
#   npm run assistant:models
GEMINI_MODEL=gemini-3.5-flash

# How long to wait for an answer before giving up and telling the user to retry.
GEMINI_TIMEOUT_MS=20000

# Ceiling on the length of one reply. Support answers are short by design.
GEMINI_MAX_OUTPUT_TOKENS=800

# ---------------------------------------------------------------- payments
#
# Which gateway collects fares is a platform setting an admin changes in the
# console (`finance.paymentProvider`: none | sandbox | phonepe). The credentials
# that gateway needs are here, and are never stored in MongoDB or returned by
# any API — including the admin API.

# The payee shown on a UPI intent, used by the sandbox provider's QR.
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=
UPI_MERCHANT_CODE=

# ------------------------------------------------------------------ PhonePe
#
# Obtained from the PhonePe merchant dashboard. PhonePe does not publish shared
# sandbox credentials — each merchant is issued their own, so these are blank
# here and must be filled in per environment. See docs/PHONEPE.md.
#
# `sandbox` (the default) talks to api-preprod.phonepe.com and moves no real
# money. Only `production` talks to the live host.
PHONEPE_ENV=sandbox

PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=

# Where PhonePe sends the customer back to. Must be reachable from their phone,
# so a tunnel rather than localhost during development.
PHONEPE_REDIRECT_URL=

# The webhook credentials configured against the callback URL in the PhonePe
# dashboard. PhonePe sends SHA256(username:password) as the Authorization
# header; without these, callbacks are refused rather than trusted.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Optional. Override only if PhonePe serves your account on a different host —
# their UAT page and their API reference disagree about the sandbox path.
PHONEPE_BASE_URL=
PHONEPE_AUTH_BASE_URL=

# Optional. How long a checkout stays payable (300-3600) and how long to wait
# on a PhonePe call before giving up.
PHONEPE_EXPIRE_AFTER_SECONDS=900
PHONEPE_TIMEOUT_MS=15000

# ---------------------------------------------------------------- Google sign-in
#
# Raahi uses Google Identity Services with an ID token: the browser gets a
# signed JWT from Google and this backend verifies it against Google's public
# keys. NO CLIENT SECRET TAKES PART IN THAT EXCHANGE, so there is no
# GOOGLE_CLIENT_SECRET here and none to keep out of Vite — the one value below
# is public by design and identifies which application a token was minted for.
#
# Leave it empty and Google sign-in is simply not offered; the password flow is
# unaffected and the button does not appear.
#
# Get one from the Google Cloud console: APIs & Services -> Credentials ->
# OAuth 2.0 Client ID, type "Web application". Add your app's origin to
# "Authorised JavaScript origins" (e.g. http://localhost:3000). No redirect URI
# is needed for this flow.
GOOGLE_CLIENT_ID=
